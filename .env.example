# Copy to .env to run in live mode (python src/benchmark.py --live).
# Offline mode needs none of these.

# openai | custom | gemini | anthropic | ollama | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0

# Judge model for Response quality in live mode (defaults to the main model)
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Memory knobs
COMPACT_THRESHOLD_TOKENS=800
COMPACT_KEEP_MESSAGES=4
PROFILE_CONFIDENCE_THRESHOLD=0.6
